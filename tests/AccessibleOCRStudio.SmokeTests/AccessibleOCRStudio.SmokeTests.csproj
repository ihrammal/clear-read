<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework><UseWPF>true</UseWPF><RuntimeFrameworkVersion>8.0.32</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AccessibleOCRStudio\AccessibleOCRStudio.csproj" />
    <Content Include="..\..\runtime\pdf\**\*" Link="pdf\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\image\**\*" Link="image\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\licenses\poppler\**\*" Link="licenses\poppler\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\licenses\imagemagick\**\*" Link="licenses\imagemagick\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Keep the Windows API reference pack independent of the .NET servicing version. -->
  <ItemGroup><FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref" RuntimeFrameworkVersion="10.0.17763.56" /></ItemGroup>
  <Target Name="CopyPaddleTests" AfterTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\copy-paddle-runtime.ps1&quot; -Destination &quot;$(TargetDir)paddle&quot;" />
  </Target>
</Project>


