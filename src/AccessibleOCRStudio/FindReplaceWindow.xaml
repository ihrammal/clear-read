<Window x:Class="AccessibleOCRStudio.FindReplaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Find and Replace" Height="300" Width="520" WindowStartupLocation="CenterOwner" MinWidth="320" MinHeight="240" ResizeMode="CanResize">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Find text:" Margin="0,0,0,4"/>
    <TextBox x:Name="FindText" Grid.Row="1" Margin="0,0,0,10" AutomationProperties.Name="Find text"/>
    <TextBlock Grid.Row="2" Text="Replace with:" Margin="0,0,0,4"/>
    <TextBox x:Name="ReplaceText" Grid.Row="3" Margin="0,0,0,12" AutomationProperties.Name="Replacement text"/>
    <StackPanel Grid.Row="4">
      <CheckBox x:Name="MatchCase" Content="Match case" Margin="0,0,0,10"/>
      <WrapPanel HorizontalAlignment="Right">
        <Button Content="Find Next" IsDefault="True" MinWidth="90" Margin="4" Click="FindNext_Click"/>
        <Button x:Name="ReplaceButton" Content="Replace" MinWidth="80" Margin="4" Click="Replace_Click"/>
        <Button x:Name="ReplaceAllButton" Content="Replace All" MinWidth="90" Margin="4" Click="ReplaceAll_Click"/>
        <Button Content="Close" IsCancel="True" MinWidth="75" Margin="4"/>
      </WrapPanel>
      <TextBlock x:Name="ResultText" AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
  </ScrollViewer>
</Window>
