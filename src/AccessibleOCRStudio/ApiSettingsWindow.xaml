<Window x:Class="AccessibleOCRStudio.ApiSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="API and Privacy Settings" Height="560" Width="700" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="API and privacy" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
<CheckBox x:Name="OfflineOnly" Content="Offline only mode (recommended)" Margin="0,5"/>
<CheckBox x:Name="AllowContent" Content="Allow document content to be sent to configured API services" Margin="0,5"/>
<TextBlock Text="Provider" Margin="0,12,0,0"/><ComboBox x:Name="Provider" Margin="0,5" AutomationProperties.Name="API provider"><ComboBoxItem Content="None"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Custom"/></ComboBox>
<TextBlock Text="API key" Margin="0,12,0,0"/><PasswordBox x:Name="ApiKey" Margin="0,5" AutomationProperties.Name="API key"/>
<TextBlock Text="API keys are protected for the current Windows user and are not stored in settings.json." TextWrapping="Wrap" Margin="0,8"/>
<CheckBox x:Name="OcrCorrection" Content="Allow API-assisted OCR correction" Margin="0,5"/><CheckBox x:Name="ImageDescription" Content="Allow image description" Margin="0,5"/><CheckBox x:Name="TableReconstruction" Content="Allow table reconstruction" Margin="0,5"/>
</StackPanel></ScrollViewer><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Save" Width="90" Margin="4" IsDefault="True" Click="Save_Click"/><Button Content="Cancel" Width="90" Margin="4" IsCancel="True"/></StackPanel></Grid></Window>
