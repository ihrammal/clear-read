<Window x:Class="AccessibleOCRStudio.RecognitionReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Recognition Review" Height="520" Width="820" MinHeight="320" MinWidth="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Potential recognition problems" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
<ListBox x:Name="Items" Grid.Row="1" AutomationProperties.Name="Potential recognition problems" SelectionChanged="Items_SelectionChanged" DisplayMemberPath="DisplayText"/>
<StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Selected text"/><TextBox x:Name="SelectedText" MinHeight="80" Margin="0,5,0,8" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Selected recognition text"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Go to text" Width="110" Margin="4" Click="GoTo_Click"/><Button Content="Close" Width="90" Margin="4" IsCancel="True"/></StackPanel></StackPanel>
</Grid></Window>
